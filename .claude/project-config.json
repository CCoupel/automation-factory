{
  "name": "Automation Factory",
  "team_name": "automation-factory-team",
  "org": "CCoupel",
  "project": "automation-factory",
  "description": "SaaS web app to visually build Ansible playbooks via drag & drop, with live Ansible Galaxy integration (2200+ namespaces, SMART cache service) and standard YAML export.",
  "version": "2.4.3",
  "initialized_at": "2026-09-16",
  "initialized_from": "analysis",
  "src_dir": "backend/app",
  "version_file": "backend/app/version.py",
  "stack": {
    "backend": {
      "language": "python",
      "framework": "fastapi"
    },
    "frontend": {
      "language": "typescript",
      "framework": "react"
    },
    "mobile": null,
    "firmware": null,
    "plugin": null,
    "database": {
      "primary": "postgresql",
      "orm": "sqlalchemy"
    }
  },
  "infrastructure": {
    "cicd": "github-actions",
    "environments": [
      {
        "name": "QUALIF",
        "order": 1,
        "url": "http://192.168.1.217",
        "publish": {
          "mode": "promote",
          "target": "build/qualif_v{X.Y.Z}/"
        },
        "deploy": {
          "mechanism": "docker-compose",
          "target": "docker-compose.staging.yml",
          "services": [
            "automation-factory-backend",
            "automation-factory-frontend",
            "nginx"
          ]
        },
        "access": {
          "method": "docker-tcp",
          "host": "192.168.1.217",
          "port": 2375,
          "runtime": "docker",
          "registry": "local (daemon 192.168.1.217)",
          "env_file": "build/qualif_v{X.Y.Z}/release.env",
          "credentials_env": [],
          "verified": {
            "status": "ok",
            "at": "2026-10-31T15:58:40Z",
            "checks": [
              "docker-api",
              "compose"
            ],
            "notes": "daemon 29.2.1 + compose v2.39.1 joignables ; stack staging arretee (port 80 ferme) et aucune image automation-factory presente au moment du test"
          }
        }
      },
      {
        "name": "PROD",
        "order": 2,
        "url": "https://coupel.net/automation-factory",
        "publish": {
          "mode": "rebuild-ci",
          "trigger": "git-tag",
          "pipeline": ".github/workflows/release.yml"
        },
        "deploy": {
          "mechanism": "helm",
          "target": "helm/automation-factory",
          "services": [
            "automation-factory-backend",
            "automation-factory-frontend"
          ]
        },
        "access": {
          "method": "kubeconfig",
          "context": "k8s",
          "kubeconfig": "kubeconfig.txt",
          "namespace": "automation-factory",
          "release": "automation-factory",
          "registry": "ghcr.io/ccoupel",
          "credentials_env": [
            "KUBECONFIG",
            "DEPLOY_DB_PASSWORD",
            "DEPLOY_JWT_SECRET_KEY"
          ],
          "verified": {
            "status": "ok",
            "at": "2026-11-03T15:30:00Z",
            "checks": [
              "kube-auth",
              "kubectl-get-pods",
              "helm-history",
              "gh-push"
            ],
            "notes": "2026-11-03 : nouveau kubeconfig Rancher OK (auth whoami system:authenticated, pods et helm history lisibles, release deployed rev 2 = 2.4.3) ; lecture seule"
          }
        }
      }
    ]
  },
  "testing": {
    "backend": [
      "pytest"
    ],
    "frontend": [
      "vitest"
    ],
    "e2e": [
      "custom-shell-scripts-needs-repair"
    ],
    "regression_at_qa": "gated",
    "full_regression_at": "qualif",
    "coverage_min": 70,
    "lot_max_tests": 50
  },
  "security": {
    "concerns": [
      "auth",
      "multi-tenant",
      "api-public"
    ]
  },
  "commands": {
    "build": "cd frontend && npm run build",
    "build_validate": "ls -la frontend/dist/index.html",
    "server_stop": "docker -H tcp://192.168.1.217:2375 compose -f docker-compose.staging.yml down",
    "server_restart": "docker -H tcp://192.168.1.217:2375 compose -f docker-compose.staging.yml up -d",
    "server_verify": "curl -I http://192.168.1.217/health && curl http://192.168.1.217/api/version && curl -I http://192.168.1.217/",
    "version_read": "python3 scripts/version.py get",
    "test": "cd backend && python -m pytest tests/ -v --cov=app && cd ../frontend && npm test",
    "lint": "cd backend && ruff check . && cd ../frontend && npm run lint",
    "audit": "cd frontend && npm audit",
    "typecheck": "cd frontend && npx tsc --noEmit",
    "coverage": "cd backend && python -m pytest tests/ --cov=app --cov-report=term-missing && cd ../frontend && npm run test:coverage",
    "ci": "bash scripts/ci.sh"
  },
