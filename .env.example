# Secrets de déploiement PROD — ne jamais committer le fichier .env réel (déjà gitignoré)
# Copier en .env, remplir avec les vraies valeurs (après rotation), puis au déploiement :
#   source .env
#   helm upgrade automation-factory ./helm/automation-factory \
#     --namespace automation-factory \
#     --values custom-values.yaml \
#     --set postgresql.auth.password="$DEPLOY_DB_PASSWORD" \
#     --set backend.env.SECRET_KEY="$DEPLOY_JWT_SECRET_KEY" \
#     --timeout 300s

DEPLOY_DB_PASSWORD=
DEPLOY_JWT_SECRET_KEY=

# Variables detectees dans les fichiers existants du projet (docker-compose.yml, workflows...) — a verifier manuellement, aucune valeur lue ni copiee :
CHANGELOG=
CHART_VERSION=
COMMIT_DATE=
COMMIT_HASH=
COMMIT_MSG=
COMPARE_LINK=
COUNT=
CURRENT_BODY=
DEBUG=
ENVIRONMENT=
GITHUB_OUTPUT=
GITHUB_REF=
GITHUB_REF_NAME=
GITHUB_TOKEN=
IMAGE_TAG=
NGINX_PORT=
PRERELEASE=
PREV_TAG=
RELEASES=
TAG=
TAGS=
TAG_NAME=
TOTAL=
VERSION=
host=
http_upgrade=
proxy_add_x_forwarded_for=
remote_addr=
