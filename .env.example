# Secrets de déploiement PROD — ne jamais committer le fichier .env réel (déjà gitignoré)
# Copier en .env, remplir avec les vraies valeurs (après rotation), puis au déploiement :
#   source .env
#   helm upgrade automation-factory ./helm/automation-factory \
#     --namespace automation-factory \
#     --values custom-values.yaml \
#     --set postgresql.auth.password="$DEPLOY_DB_PASSWORD" \
#     --set backend.env.SECRET_KEY="$DEPLOY_JWT_SECRET_KEY" \
#     --timeout 300s

DEPLOY_DB_PASSWORD=
DEPLOY_JWT_SECRET_KEY=
